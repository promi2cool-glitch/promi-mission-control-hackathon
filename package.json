{
  "name": "promi-mission-control-hackathon",
  "version": "0.0.1",
  "private": true,
  "description": "Verification-first orchestration layer for dispatching bounded autonomous missions to Quirq/XO and independently verifying results.",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run test:mission",
    "test:mission": "npm run build && node --test \"tests/**/*.test.js\"",
    "test:demo": "node --test \"demo_project/test/**/*.test.js\"",
    "test:xo": "npm run build && node --test \"tests/xo/**/*.test.js\"",
    "verify": "node scripts/verify.mjs",
    "mission:demo": "npm run build && node dist/cli/missionDemo.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
